# Slack Bot Token (OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-...

# Slack Signing Secret (Basic Information → Signing Secret)
SLACK_SIGNING_SECRET=...

# Slack App-Level Token (Socket Mode → App-Level Token, connections:write 권한)
SLACK_APP_TOKEN=xapp-...

# PagerDuty API Token (My Profile → User Settings → API Access)
PAGERDUTY_API_TOKEN=...

# Jira API (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=your-email@kakaostyle.com
JIRA_API_TOKEN=...

# PagerDuty 스케줄 ID
PAGERDUTY_AOS_SCHEDULE_ID=PIQG8OK
PAGERDUTY_IOS_SCHEDULE_ID=PEEV7ZX
